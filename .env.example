# ===== rubrikRKS configuration =====
# Copy this file to .env and adjust values. Never commit .env.

# Flask secret key — REQUIRED, use a long random string in production
RKS_SECRET_KEY=dev-secret-change-me

# App port (used by `python app.py`)
RKS_PORT=5000

# Database engine: "mysql" or "sqlite"
RKS_DB_ENGINE=mysql

# MySQL connection (only used when RKS_DB_ENGINE=mysql)
RKS_MYSQL_HOST=localhost
RKS_MYSQL_PORT=3306
RKS_MYSQL_USER=rubrikrks
RKS_MYSQL_PASSWORD=rubrikrks_dev_2026
RKS_MYSQL_DB=rubrikrks

# SQLite database file (only used when RKS_DB_ENGINE=sqlite)
# RKS_DB_FILE=rubrikrks.db
